# Shared
DATABASE_URL=postgres://erp:erp@localhost:5432/erp
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:5173
APP_ENV=development

# Auth (better-auth)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=otopio.ca
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Initial admin seeded with email/password (until Google OAuth is configured)
ADMIN_EMAIL=sami@otopio.ca
ADMIN_PASSWORD=

# Cloudflare R2 (files + CDN + DB backups)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=otopio-erp
R2_BACKUP_BUCKET=otopio-erp-backups
R2_PUBLIC_URL=

# Integrations (optional — UI shows "not connected" when empty)
GITHUB_TOKEN=
GITHUB_ORG=otopio-org
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
QONTO_LOGIN=
QONTO_SECRET_KEY=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Worker
CHROMIUM_PATH=/usr/bin/chromium
BACKUP_CRON=0 3 * * *
